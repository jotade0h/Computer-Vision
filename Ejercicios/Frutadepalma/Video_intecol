import cv2
import os

def reproducir_y_extraer(video_path, output_folder, window_width=640, window_height=480):
    # Verificar si la carpeta de salida existe, si no, crearla
    if not os.path.exists(output_folder):
        os.makedirs(output_folder)

    # Cargar el video
    video = cv2.VideoCapture(video_path)

    # Verificar si el video se cargó correctamente
    if not video.isOpened():
        print("Error al abrir el video")
        return

    # Obtener la cantidad de frames por segundo (fps) y resolución del video original
    fps = video.get(cv2.CAP_PROP_FPS)
    original_width = int(video.get(cv2.CAP_PROP_FRAME_WIDTH))
    original_height = int(video.get(cv2.CAP_PROP_FRAME_HEIGHT))

    # Mostrar el video frame por frame
    frame_count = 0
    while True:
        ret, frame = video.read()
        if not ret:
            print("Video finalizado.")
            break  # Salir si no hay más frames

        # Redimensionar el frame solo para mostrarlo en una ventana más pequeña
        resized_frame = cv2.resize(frame, (window_width, window_height))

        # Mostrar el frame redimensionado en una ventana
        cv2.imshow('Video', resized_frame)

        # Esperar el tiempo adecuado para que el video se reproduzca a velocidad normal
        key = cv2.waitKey(int(1000 / fps))  # Controla la velocidad de reproducción

        # Si se presiona Enter (key == 13), guardar el frame original en su resolución
        if key == 13:  # Enter tiene el valor 13
            # Calcular el tiempo en segundos
            second = frame_count / fps
            image_name = f"{second:.2f}s.jpg"
            image_path = os.path.join(output_folder, image_name)

            # Guardar la imagen en resolución original
            cv2.imwrite(image_path, frame)
            print(f"Imagen guardada: {image_name}")

        # Salir si se presiona la tecla 'q'
        if key == ord('q'):
            print("Saliendo del video.")
            break

        # Incrementar el contador de frames
        frame_count += 1

    # Liberar el video y cerrar ventanas
    video.release()
    cv2.destroyAllWindows()

# Ruta del video y carpeta de salida
video_path = 'Fruits.mp4'  # Especifica la ruta del video aquí
output_folder = 'imagenes_extraidas'  # Carpeta donde se guardarán las imágenes

# Llamar a la función para reproducir el video y extraer imágenes, con ventana redimensionada
reproducir_y_extraer(video_path, output_folder, window_width=640, window_height=480)

print("Proceso completado.")
